# Copy this file to ".env" and fill in your real values.
# ".env" itself must NEVER be committed to git (see .gitignore).

# Local Postgres example:
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/expense_tracker

# On Render, you won't need this file at all — you'll paste the same variable into the Render dashboard's Environment tab instead, using the "Internal Database URL" Render gives you for your Postgres instance.
